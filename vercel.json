    { "source": "/predictions/:matchSlug", "destination": "/predict/:matchSlug", "permanent": true },
    { "source": "/tips", "destination": "/best-bets", "permanent": true },
    { "source": "/free-tips", "destination": "/best-bets", "permanent": true },
    { "source": "/betting-tips", "destination": "/best-bets", "permanent": true },
    { "source": "/today", "destination": "/best-bets", "permanent": true },
    { "source": "/tomorrow", "destination": "/upcoming", "permanent": true },
