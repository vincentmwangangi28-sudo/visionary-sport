    { "source": "/jackpot", "destination": "/jackpot-predictions", "permanent": true },
    { "source": "/mega-jackpot", "destination": "/jackpot-predictions", "permanent": true },
    { "source": "/epl", "destination": "/premier-league-predictions", "permanent": true },
