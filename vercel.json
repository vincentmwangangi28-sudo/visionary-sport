    { "source": "/ucl", "destination": "/champions-league-predictions", "permanent": true },
    { "source": "/champions-league", "destination": "/champions-league-predictions", "permanent": true },
    { "source": "/laliga", "destination": "/la-liga-predictions", "permanent": true },
    { "source": "/la-liga", "destination": "/la-liga-predictions", "permanent": true },
    { "source": "/seriea", "destination": "/serie-a-predictions", "permanent": true },
    { "source": "/serie-a", "destination": "/serie-a-predictions", "permanent": true },
    { "source": "/bundesliga", "destination": "/bundesliga-predictions", "permanent": true },
    { "source": "/kpl", "destination": "/kpl-predictions", "permanent": true },
    { "source": "/kenya-premier-league", "destination": "/kpl-predictions", "permanent": true },
    { "source": "/world-cup", "destination": "/world-cup-predictions", "permanent": true },
    { "source": "/afcon", "destination": "/afcon-predictions", "permanent": true },
    { "source": "/mls", "destination": "/us-soccer-predictions", "permanent": true },
    { "source": "/livescore", "destination": "/live", "permanent": true },
    { "source": "/livescores", "destination": "/live", "permanent": true },
    { "source": "/live-scores", "destination": "/live", "permanent": true },
    { "source": "/acca", "destination": "/accumulator", "permanent": true },
    { "source": "/accumulators", "destination": "/accumulator", "permanent": true },
    { "source": "/both-teams-to-score", "destination": "/btts", "permanent": true },
    { "source": "/correct-scores", "destination": "/correct-score", "permanent": true },
    { "source": "/table", "destination": "/standings", "permanent": true },
    { "source": "/tables", "destination": "/standings", "permanent": true },
    { "source": "/odds", "destination": "/dropping-odds", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/api/gemini-tasks",
      "destination": "https://bhgjlhgevyggkhyytulv.supabase.co/functions/v1/gemini-tasks"
    },
    {
      "source": "/api/ping-search-engines",
      "destination": "https://bhgjlhgevyggkhyytulv.supabase.co/functions/v1/ping-search-engines"
    },
    {
      "source": "/((?!api/|f7qprb5m24wrvjdmkspy56hhvjmhkcn5\\.txt|ccf4ef0c532c4444b096f02474b4320a\\.txt|sitemap\\.xml|sitemap-yandex\\.xml|robots\\.txt|ads\\.txt|manifest\\.json|sw\\.js|.*\\.txt|.*\\.html|.*\\.png|.*\\.svg|.*\\.ico).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/indexing-cron",
      "schedule": "0 5 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(sitemap\\.xml|sitemap-yandex\\.xml)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "X-Robots-Tag",
          "value": "all"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "X-Robots-Tag",
          "value": "all"
        }
      ]
    },
    {
      "source": "/favicon.ico",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/x-icon"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "X-Robots-Tag",
          "value": "all"
        }
      ]
    },
    {
      "source": "/favicon.svg",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/svg+xml"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "X-Robots-Tag",
          "value": "all"
        }
      ]
    },
    {
      "source": "/(favicon-.*\\.png|apple-touch-icon\\.png|icon-.*\\.png)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/png"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "X-Robots-Tag",
          "value": "all"
        }
      ]
    },
    {
      "source": "/f7qprb5m24wrvjdmkspy56hhvjmhkcn5.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "X-Robots-Tag",
          "value": "all"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self' https: data: blob: 'unsafe-inline' 'unsafe-eval'; connect-src 'self' https: wss:; img-src 'self' https: data: blob:; media-src 'self' https: data: blob:; frame-src 'self' https:; object-src 'none'; base-uri 'self'; upgrade-insecure-requests;"
        }
      ]
    }
  ]
}
